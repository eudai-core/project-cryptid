--!strict

local NODE = 96
local CAP = 128

local function effect(kind: string, value: number, text: string)
	return table.freeze({
		kind = kind,
		value = value,
		text = text,
	})
end

local function rite(
	id: string,
	name: string,
	branch: string,
	x: number,
	y: number,
	requires: { string },
	cost: number,
	ring: number,
	sealed: boolean,
	capstone: boolean,
	kind: string,
	value: number,
	text: string,
	branchLine: string
)
	return table.freeze({
		id = id,
		name = name,
		branch = branch,
		x = x,
		y = y,
		requires = table.freeze(requires),
		cost = cost,
		currency = "cash",
		ring = ring,
		sealed = sealed,
		size = if capstone then CAP else NODE,
		effect = effect(kind, value, text),
		branchLine = branchLine,
	})
end

