local byId = {}
for _, node in built do
	byId[node.id] = node
end

local edges = {}
for _, id in ORDER do
	local node = byId[id]
	for _, parentId in node.requires do
		table.insert(
			edges,
			table.freeze({
				parent = parentId,
				child = id,
			})
		)
	end
end

