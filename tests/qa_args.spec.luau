--!strict

_G.LUNE = true

local fs = require("@lune/fs")
local Check = require("./check")
local QaArgs = require("../src/server/Dev/QaArgs")
local QaConfig = require("../src/server/Dev/QaConfig")
local WatchdogBudget = require("../src/server/Dev/WatchdogBudget")

Check.test("QA cash grant parses a valid token", function()
	Check.eq(QaConfig.MAX_GRANT, 10000000)
	Check.eq(QaArgs.cashGrant("qa:600:cash50000"), 50000)
	Check.eq(QaArgs.cashGrant("qa:600:cash0"), 0)
	Check.eq(QaArgs.cashGrant("qa:600:cash00050"), 50)
	Check.eq(QaArgs.cashGrant("qa:600:cash10000000"), QaConfig.MAX_GRANT)
	Check.eq(WatchdogBudget.secondsFor("qa:600:cash50000"), 600)
end)

Check.test("QA cash grant is absent when the token is missing", function()
	Check.eq(QaArgs.cashGrant(nil), nil)
	Check.eq(QaArgs.cashGrant(""), nil)
	Check.eq(QaArgs.cashGrant("play"), nil)
	Check.eq(QaArgs.cashGrant("qa:600"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:plots3"), nil)
	Check.eq(QaArgs.cashGrant("qa:"), nil)
	Check.eq(QaArgs.cashGrant("qa:abc"), nil)
	Check.eq(QaArgs.cashGrant({ "qa:600:cash50000" }), nil)
end)

Check.test("QA cash grant rejects a malformed token", function()
	Check.eq(QaArgs.cashGrant("qa:600:cash"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:cashabc"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:cash-5"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:cash12.5"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:cash 50"), nil)
	Check.eq(QaArgs.cashGrant("qa:cash50000"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:Cash50000"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:cash50000extra"), nil)
	Check.eq(QaArgs.cashGrant("qa:600:cash50000:cashabc"), nil)
end)

Check.test("QA cash grant clamps to the config cap", function()
	Check.eq(QaArgs.cashGrant("qa:600:cash10000001"), QaConfig.MAX_GRANT)
	Check.eq(QaArgs.cashGrant("qa:600:cash99999999"), QaConfig.MAX_GRANT)
	Check.eq(QaArgs.cashGrant("qa:300:cash10000000"), 10000000)
end)

Check.test("QA cash grant combines with the plots3 suffix", function()
	Check.eq(QaArgs.cashGrant("qa:600:plots3:cash50000"), 50000)
	Check.eq(QaArgs.cashGrant("qa:600:cash50000:plots3"), 50000)
	Check.eq(WatchdogBudget.secondsFor("qa:600:plots3:cash50000"), 600)
	Check.eq(WatchdogBudget.secondsFor("qa:420:cash50000:plots3"), 420)
end)

Check.test("QA cash grant returns before it can run outside Studio", function()
	local text = fs.readFile("src/server/Dev/QaGrant.luau")
	local studioAt = string.find(text, "if not RunService:IsStudio() then", 1, true)
	local argsAt = string.find(text, "StudioTestService:GetTestArgs()", 1, true)
	local grantAt = string.find(text, "profile.cash", 1, true)
	Check.truthy(studioAt)
	Check.truthy(argsAt)
	Check.truthy(grantAt)
	Check.eq(studioAt < argsAt, true)
	Check.eq(studioAt < grantAt, true)
	Check.contains(text, "[Cryptid:QA] granted cash %d to %d")
	Check.eq(string.find(text, "totalEarned", 1, true), nil)
	Check.eq(string.find(text, "RemoteEvent", 1, true), nil)
	Check.eq(string.find(text, "FireServer", 1, true), nil)
	Check.eq(string.find(text, "Chatted", 1, true), nil)
	Check.eq(string.find(text, "TextChatService", 1, true), nil)
	local session = fs.readFile("src/server/PlayerSession.luau")
	Check.contains(session, "QaGrant.apply(profile, player.UserId)")
	local names = fs.readFile("src/shared/Config/Remotes.luau")
	Check.eq(string.find(names, "QaCash", 1, true), nil)
	Check.eq(string.find(names, "GrantCash", 1, true), nil)
end)
