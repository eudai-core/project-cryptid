--!strict

_G.LUNE = true

local fs = require("@lune/fs")
local Check = require("./check")
local QaArgs = require("../src/shared/Logic/QaArgs")
local Save = require("../src/shared/Config/Save")
local StudioQa = require("../src/server/Dev/StudioQa")
local WatchdogBudget = require("../src/server/Dev/WatchdogBudget")

Check.test("nohud parses and combines with the other qa suffixes", function()
	Check.eq(QaArgs.parse("qa:600:nohud").noHud, true)
	Check.eq(QaArgs.parse("qa:600:nohud").fresh, false)
	Check.eq(QaArgs.parse("qa:600").noHud, false)
	Check.eq(QaArgs.parse("qa:600:Nohud").noHud, false)
	Check.eq(QaArgs.parse("play").noHud, false)
	Check.eq(QaArgs.parse(nil).noHud, false)
	local mixed = QaArgs.parse("qa:600:fresh:nohud:tarot:tarotblood:rebirthready:opentree")
	Check.eq(mixed.noHud, true)
	Check.eq(mixed.fresh, true)
	Check.eq(mixed.tarot, true)
	Check.eq(mixed.tarotBlood, true)
	Check.eq(mixed.rebirthReady, true)
	Check.eq(mixed.openTree, true)
	Check.eq(QaArgs.parse("qa:600:nohud:fresh").fresh, true)
	Check.eq(QaArgs.parse("qa:600:nohud:fresh").noHud, true)
	Check.eq(QaArgs.parse("qa:600:offline:7200:nohud").offlineSeconds, 7200)
	Check.eq(QaArgs.parse("qa:600:plots3:nohud").noHud, true)
	Check.eq(WatchdogBudget.secondsFor("qa:600:fresh:nohud"), 600)
	Check.eq(WatchdogBudget.secondsFor("qa:600:nohud"), 600)
	Check.eq(StudioQa.plan(true, "qa:600:fresh:nohud"), "load")
	Check.eq(StudioQa.plan(false, "qa:600:nohud"), "load")
end)

Check.test("nohud is inert outside Studio", function()
	Check.eq(QaArgs.noHud(false, "qa:600:nohud"), false)
	Check.eq(QaArgs.noHud(false, "qa:600:fresh:nohud"), false)
	Check.eq(QaArgs.noHud(false, "qa:600:nohud:fresh"), false)
	Check.eq(QaArgs.noHud(true, "qa:600:nohud"), true)
	Check.eq(QaArgs.noHud(true, "qa:600:fresh:nohud"), true)
	Check.eq(QaArgs.noHud(true, "qa:600"), false)
	Check.eq(QaArgs.noHud(true, "qa:600:fresh"), false)
	Check.eq(QaArgs.noHud(true, nil), false)
	Check.eq(QaArgs.noHud(true, "play"), false)

	local hooks = fs.readFile("src/server/Dev/StudioQaHooks.luau")
	local fnAt = string.find(hooks, "function StudioQaHooks.noHud()", 1, true)
	Check.truthy(fnAt)
	local guardAt = string.find(hooks, "if not RunService:IsStudio() then", fnAt :: number, true)
	local readAt = string.find(hooks, "tokens().noHud", fnAt :: number, true)
	Check.truthy(guardAt)
	Check.truthy(readAt)
	Check.eq((guardAt :: number) < (readAt :: number), true)
	Check.eq(string.find(hooks, "RemoteEvent", 1, true), nil)
	Check.eq(string.find(hooks, "FireClient", 1, true), nil)

	local session = fs.readFile("src/server/PlayerSession.luau")
	local ifAt = string.find(session, "if StudioQaHooks.noHud() then", 1, true)
	local setAt = string.find(session, 'player:SetAttribute("QaNoHud", true)', 1, true)
	Check.truthy(ifAt)
	Check.truthy(setAt)
	Check.eq((setAt :: number) > (ifAt :: number), true)
	Check.eq((setAt :: number) - (ifAt :: number) < 80, true)
	local joinAt = string.find(session, "function PlayerSession.onPlayer", 1, true)
	Check.truthy(joinAt)
	local callAt = string.find(session, "markQaNoHud(player)", joinAt :: number, true)
	local loadAt = string.find(session, "DataStoreGateway.load(player.UserId, created)", joinAt :: number, true)
	Check.truthy(callAt)
	Check.truthy(loadAt)
	Check.eq((callAt :: number) < (loadAt :: number), true)

	local names = fs.readFile("src/shared/Config/Remotes.luau")
	Check.eq(string.find(names, "QaNoHud", 1, true), nil)
	Check.eq(string.find(names, "nohud", 1, true), nil)
	Check.eq(Save.DATA_VERSION, 10)
	Check.eq(string.find(fs.readFile("src/shared/Logic/OnboardingGoals.luau"), "QaNoHud", 1, true), nil)
	Check.eq(string.find(fs.readFile("src/shared/Logic/Daily.luau"), "QaNoHud", 1, true), nil)
	Check.eq(string.find(fs.readFile("src/shared/Logic/Transactions.luau"), "QaNoHud", 1, true), nil)
end)

Check.test("each listed overlay stays hidden while QaNoHud is set", function()
	local shots = fs.readFile("src/client/QaShots.luau")
	Check.contains(shots, 'ATTRIBUTE = "QaNoHud"')
	Check.contains(shots, "GetAttribute(ATTRIBUTE) == true")
	Check.contains(shots, "gui.Visible = false")
	Check.contains(shots, "layer.Enabled = false")
	Check.eq(string.find(shots, "Heartbeat", 1, true), nil)
	Check.eq(string.find(shots, "RenderStepped", 1, true), nil)
	Check.eq(string.find(shots, "FireServer", 1, true), nil)
	Check.eq(string.find(shots, "RemoteEvent", 1, true), nil)

	local function respects(path: string, needle: string)
		local text = fs.readFile(path)
		Check.contains(text, "QaShots")
		Check.contains(text, needle)
		Check.eq(string.find(text, "Heartbeat", 1, true), nil)
	end

	local banner = fs.readFile("src/client/GoalBanner.luau")
	Check.contains(banner, "QaShots.conceal(frame)")
	Check.contains(banner, "QaShots.conceal(action)")
	Check.contains(banner, "not QaShots.hidden()")
	Check.contains(banner, "frame.Visible = false")
	Check.contains(banner, "action.Visible = false")

	local offering = fs.readFile("src/client/OfferingPanel.luau")
	Check.contains(offering, "QaShots.conceal(button)")
	Check.contains(offering, "QaShots.conceal(backdrop)")
	Check.contains(offering, "if QaShots.hidden() then")
	Check.contains(offering, "if on and QaShots.hidden() then")
	Check.contains(offering, "if QaShots.hidden() or latest == nil or isBlocked() then")

	local rite = fs.readFile("src/client/RebirthPanel.luau")
	Check.contains(rite, "QaShots.conceal(root)")
	Check.contains(rite, "root.Visible = false")
	local openAt = string.find(rite, "function api.open()", 1, true)
	Check.truthy(openAt)
	local openGuard = string.find(rite, "if QaShots.hidden() then", openAt :: number, true)
	local openShow = string.find(rite, "root.Visible = true", openAt :: number, true)
	Check.truthy(openGuard)
	Check.truthy(openShow)
	Check.eq((openGuard :: number) < (openShow :: number), true)

	respects("src/client/CashPlaque.luau", "QaShots.conceal(frame)")
	respects("src/client/HudMenu.luau", "QaShots.conceal(root)")
	respects("src/client/Main.client.luau", "QaShots.conceal(vignetteTop)")

	local rites = fs.readFile("src/client/SkillTree.luau")
	Check.contains(rites, "QaShots.concealEnabled(screen)")
	Check.contains(rites, 'GetAttributeChangedSignal("QaNoHud")')
	local treeAt = string.find(rites, "openTree = function()", 1, true)
	Check.truthy(treeAt)
	local treeGuard = string.find(rites, "if QaShots.hidden() then", treeAt :: number, true)
	local treeShow = string.find(rites, "screen.Enabled = true", treeAt :: number, true)
	Check.truthy(treeGuard)
	Check.truthy(treeShow)
	Check.eq((treeGuard :: number) < (treeShow :: number), true)
end)
