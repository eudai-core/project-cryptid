{
  "name": "ProjectCryptid",
  "servePlaceIds": null,
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server"
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "ShadowMap"
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "MaxPlayers": 8
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$attributes": {
        "BuildSha": "dev"
      },
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "Cryptids": {
          "$path": "assets/cryptids"
        },
        "Lair": {
          "$path": "assets/lair"
        },
        "Placeholders": {
          "$path": "assets/placeholders"
        }
      }
    }
  }
}
