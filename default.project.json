{
  "name": "ProjectCryptid",
  "servePlaceIds": null,
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server"
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "Terrain": {
        "$className": "Terrain",
        "Clouds": {
          "$className": "Clouds",
          "$properties": {
            "Cover": 0.5,
            "Density": 0.4,
            "Color": [0.3764705882352941, 0.2901960784313726, 0.43137254901960786]
          }
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "ShadowMap"
      },
      "HollowmereSky": {
        "$className": "Sky",
        "$properties": {
          "CelestialBodiesShown": true,
          "MoonAngularSize": 11,
          "SkyboxBk": "rbxasset://textures/sky/sky512_bk.tex",
          "SkyboxDn": "rbxasset://textures/sky/sky512_dn.tex",
          "SkyboxFt": "rbxasset://textures/sky/sky512_ft.tex",
          "SkyboxLf": "rbxasset://textures/sky/sky512_lf.tex",
          "SkyboxRt": "rbxasset://textures/sky/sky512_rt.tex",
          "SkyboxUp": "rbxasset://textures/sky/sky512_up.tex",
          "StarCount": 3000,
          "SunAngularSize": 0
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "MaxPlayers": 8
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$attributes": {
        "BuildSha": "dev"
      },
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "Cryptids": {
          "$path": "assets/cryptids"
        },
        "Lair": {
          "$path": "assets/lair"
        },
        "Placeholders": {
          "$path": "assets/placeholders"
        }
      }
    }
  }
}
